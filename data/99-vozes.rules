# Allow active seat user to read and write to /dev/uinput
KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput", TAG+="uaccess"

# Allow active seat user to read input events directly (modern Linux/systemd way)
SUBSYSTEM=="input", KERNEL=="event*", TAG+="uaccess"

# Specifically tag Vozes Virtual Keyboard as a keyboard for Wayland compositors
SUBSYSTEM=="input", ATTRS{name}=="Vozes-Virtual-Keyboard", ENV{ID_INPUT}="1", ENV{ID_INPUT_KEYBOARD}="1", TAG+="uaccess"
